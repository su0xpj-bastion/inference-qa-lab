# NCCL fabric settings for the InfiniBand cluster (8x H100 + 8x NDR400 ConnectX-7, rail-optimized).
# Same rules as nccl-roce.env. No GID index or traffic class: IB routes by LID, not by GID.
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
NCCL_IB_HCA=^=mlx5_bond_0
NCCL_CROSS_NIC=0
NCCL_NET_GDR_LEVEL=PXB
