# NCCL fabric settings for the RoCE cluster (8x H100 + 8x 400GbE ConnectX-7, rail-optimized).
# Single source of truth: Slurm sources this file, the Ray submit script turns it into a
# runtime_env, and k8s/nccl-env-configmap.yaml must match it key for key (a test enforces that).
# NCCL_SOCKET_IFNAME is deliberately NOT here: it names the bootstrap/OOB interface, which is
# eth0 inside a pod and the host management bond under Slurm. Each launcher sets its own.
# NCCL_IB_HCA excludes the frontend bond instead of listing mlx5_0..7: inside a pod the SR-IOV
# VFs carry host-assigned names (mlx5_12, ...), so an explicit list would match nothing there.
# NCCL then pairs each GPU with its nearest HCA from PCI topology, which is what rails need.
# docs/NCCL_ENV.md explains every line.
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
NCCL_IB_HCA=^=mlx5_bond_0
NCCL_IB_GID_INDEX=3
NCCL_IB_TC=106
NCCL_IB_QPS_PER_CONNECTION=4
NCCL_CROSS_NIC=0
NCCL_NET_GDR_LEVEL=PXB
